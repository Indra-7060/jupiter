# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jupiter_cms
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@jupiterclamps.com
ADMIN_PASSWORD=Admin@12345

# Public site URL (used for absolute links / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outgoing e-mail (enquiry + job application notifications). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Jupiter Website <no-reply@jupiterclamps.com>"

# ---- Hosted deployment (Vercel) ----
# Use a connection URL instead of DB_HOST/… ; mysql:// (TiDB Cloud, Aiven, PlanetScale) or postgres:// (Neon, Vercel Postgres)
# DATABASE_URL=mysql://user:password@host:4000/jupiter_cms
# DB_SSL=true
# DB_POOL_MAX=2
# Vercel Blob token (Storage tab of the Vercel project) — required on Vercel for uploads and CVs
# BLOB_READ_WRITE_TOKEN=
